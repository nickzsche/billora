# Billora environment configuration
# Copy to .env.local and adjust as needed.

# Port for the production/dev server
PORT=3420

# Secret used to sign session JWTs (jose HS256). Change this in production!
AUTH_SECRET=change-me-to-a-long-random-string

# SQLite database file (relative to project root)
DATABASE_URL=./data/billora.db

# Seeded demo account (created automatically on first run)
DEMO_EMAIL=demo@billora.app
DEMO_PASSWORD=demo1234
